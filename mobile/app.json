{
  "expo": {
    "name": "DevPlant",
    "slug": "devplant",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devplant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mixesgates.devplant",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mixesgates.devplant",
      "adaptiveIcon": {
        "backgroundColor": "#0F1611",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#0F1611", "image": "./assets/images/splash-icon.png" }
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "DevPlant photographs one leaf to check it for pests and diseases. Photos stay on this phone." }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "DevPlant can check a leaf photo you already took. Photos stay on this phone." }
      ]
    ],
    "extra": {
      "catalogUrl": "https://devplant-cloud.vercel.app"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
